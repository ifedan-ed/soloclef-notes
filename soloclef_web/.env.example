# ─────────────────────────────────────────────────────────────────────────────
# Backend connectivity
# ─────────────────────────────────────────────────────────────────────────────

# Optional packaged-client override. Leave unset in Docker so browser requests
# use same-origin relative URLs behind Caddy. Set it for packaged clients or
# local dev that talks to the API at another origin (the Go stack's Caddy,
# for example: SOLOCLEF_GO_SITE_PUBLISH in docker/.env.go).
NEXT_PUBLIC_FASTAPI_BACKEND_URL=http://localhost:8000

# `next dev` only: where it passes /api/v1, /auth, /users and /verify-token
# (next.config.ts), standing in for the stack's Caddy. A built site is static
# files with no server code, so nothing else reads it.
SOLOCLEF_BACKEND_INTERNAL_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# This server's own address, contact and sign-in, as the public pages print them
# ─────────────────────────────────────────────────────────────────────────────
# Baked in at `next build` (the sitemap, robots.txt, canonical and share-card
# links, the JSON-LD contact point and the docs' sign-in wording), so a change
# needs a rebuild. In Docker, docker-compose.go.yml passes them from
# docker/.env.go (SOLOCLEF_API_PUBLIC_URL, SOLOCLEF_API_SUPPORT_EMAIL, the OIDC
# and sign-up settings). Empty:
# no absolute links, no contact address, no single sign-on in the docs, and
# "Request access" instead of sign-up. No server's values are built in.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_OIDC_ENABLED=FALSE
# NEXT_PUBLIC_OIDC_BUTTON_LABEL=
# NEXT_PUBLIC_OIDC_DISCOVERY_URL=
# NEXT_PUBLIC_OIDC_AUTOCREATE_DOMAINS=
# NEXT_PUBLIC_OIDC_ALLOW_SIGNUP=FALSE
# Exactly "true" offers sign-up (lib/signups.ts); docker-compose.go.yml sets it
# from SOLOCLEF_API_SIGNUP_ALLOWED, the API's own switch.
# NEXT_PUBLIC_SIGNUPS_OPEN=

# ─────────────────────────────────────────────────────────────────────────────
# PostHog analytics (optional, leave key empty to disable)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────────────────────────────────────
# Zero cache (real-time sync). Leave unset in Docker to use the same-origin
# "/zero" endpoint behind Caddy. Set it for local dev or packaged clients.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ZERO_CACHE_URL=http://localhost:4848

# ─────────────────────────────────────────────────────────────────────────────
# Stripe Payment Link (Individual licence)
# ─────────────────────────────────────────────────────────────────────────────
# The Buy a licence button on /pricing. NEXT_PUBLIC_* is baked in at
# `next build`, so a change here needs a rebuild (or a `next dev` restart).
# Leave empty to fall back to /contact.
NEXT_PUBLIC_STRIPE_LICENSE_INDIVIDUAL_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Internal build-time fallbacks
# ─────────────────────────────────────────────────────────────────────────────
#
# Most deployments should leave these unset.
#
# These are only for packaged clients and unusual builds.
#
# NEXT_PUBLIC_* values are embedded into the browser bundle during `next build`.
# Changing them after the bundle is built has no effect.

# The upload dialog's fallback file list when no runtime parser lines are set:
# PYMUPDF4LLM, LLAMACLOUD, DATALAB or UNSTRUCTURED.
# NEXT_PUBLIC_ETL_SERVICE=PYMUPDF4LLM
# NEXT_PUBLIC_DEPLOYMENT_MODE=self-hosted
# NEXT_PUBLIC_APP_VERSION=