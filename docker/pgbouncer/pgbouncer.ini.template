; PgBouncer for Soloclef Notes — the app's connection multiplexer.
;
; render-config.sh fills the @...@ placeholders from the environment and runs
; pgbouncer on the result, so this file names no server and holds no password.
; Nothing here is read by pgbouncer directly.
;
; Transaction pooling: a client connection only holds a server connection for
; the length of a transaction, so the API's idle pooled connections (four
; uvicorn workers x DB_POOL_SIZE + DB_MAX_OVERFLOW, plus the LangGraph
; checkpointer pool) and every short-lived Celery connection share the server
; connections below instead of each taking one of Postgres's 200.
;
; Session-level state does not survive transaction pooling. The app is clear
; of LISTEN/NOTIFY and session advisory locks (Alembic's advisory lock runs in
; the migrations service, which connects to Postgres directly), and the one
; session-level SET it still issues — lock_timeout around the boot-time
; CREATE INDEX CONCURRENTLY — is cleaned off the server connection by
; server_reset_query below.

[databases]
@DB_NAME@ = host=@DB_HOST@ port=@DB_PORT@ dbname=@DB_NAME@

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = @PGBOUNCER_PORT@
auth_type = scram-sha-256
auth_file = @RUNTIME_DIR@/userlist.txt
; Read-only access to SHOW POOLS / SHOW STATS on the `pgbouncer` database,
; for the deploy checks in custom/README.md. No admin_users: nothing should
; be able to PAUSE or RECONNECT the pooler with the app's credentials.
stats_users = @DB_USER@

pool_mode = transaction

; Sizing against Postgres max_connections = 200 (docker/postgresql.conf).
; zero-cache keeps a direct connection and can take 50 (ZERO_UPSTREAM_MAX_CONNS
; + ZERO_CVR_MAX_CONNS), the migrations service a handful, and 3 are reserved
; for superusers, so the pooler is capped at 100 and never squeezes them out.
; 60 server connections is 3x this host's 20 cores; work_mem is 32MB per sort
; node per connection, so this also bounds the sort memory Postgres can take.
max_client_conn = 1000
default_pool_size = 60
min_pool_size = 5
reserve_pool_size = 20
reserve_pool_timeout = 3
max_db_connections = 100

; A client that cannot be given a server connection within this long gets an
; error instead of hanging: a saturated pool shows up as failed requests in the
; logs rather than as a silently stalled API.
query_wait_timeout = 120
; Never cancel a long statement here. Hybrid search and the boot-time
; CREATE INDEX CONCURRENTLY both run for minutes; the app's own
; idle_in_transaction_session_timeout handles abandoned transactions.
query_timeout = 0
idle_transaction_timeout = 0

; DISCARD ALL after every transaction, not just in session pooling. It costs a
; round trip and it is what makes transaction pooling safe against leftover
; session state: a stray SET, a temp table or a named prepared statement can
; never reach the next client to borrow this server connection.
server_reset_query = DISCARD ALL
server_reset_query_always = 1

; The app drives asyncpg with unnamed prepared statements (see
; app/db_pooling/connect_args.py), so pgbouncer has no named statements to
; track and does not need to keep that state per client.
max_prepared_statements = 0

; Only the parameters Postgres reports back can be tracked per client, and
; idle_in_transaction_session_timeout is not one of them: listing it under
; track_extra_parameters is accepted and then silently never applied (measured
; on 1.26.1, SHOW returned the server's 0). So the app does not send it in the
; startup packet when it talks to the pooler, and the timeout is set on the
; database itself instead (docker/postgresql.conf), where it survives the
; DISCARD ALL above. Do not add it here.
ignore_startup_parameters = extra_float_digits

server_lifetime = 3600
server_idle_timeout = 600
server_connect_timeout = 15
client_login_timeout = 60

; Which pooled client a Postgres backend is serving, for pg_stat_activity.
application_name_add_host = 1
; One connection per Celery task and per uvicorn pool refill is a lot of
; connection churn; only errors and the periodic totals are worth logging.
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
stats_period = 60
