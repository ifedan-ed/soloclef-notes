# Settings for the Go stack (docker/docker-compose.go.yml).
#
#   cp docker/.env.go.example docker/.env.go
#   docker compose -p soloclefgo --env-file docker/.env.go \
#     -f docker/docker-compose.go.yml up -d --build
#
# Every line here is required: the Compose file has no default for any of
# them and stops, naming the variable, if one is missing. The one exception
# is marked. The values below are examples. They show the shape of each
# setting and are nobody's deployment: replace every one that names a host, a
# model, a network or a limit with your own.
#
# What is NOT here are the addresses the stack's services have for each other
# (Postgres, Valkey, Qdrant, MinIO, the parser service). Those are facts of
# the Compose file, not choices, and are written there.

# ── The stack ───────────────────────────────────────────────────────────────

# The host address and port the site is published on, together: Caddy's,
# the stack's one published port. Loopback unless a reverse proxy on
# another machine has to reach it.
SOLOCLEF_GO_SITE_PUBLISH=127.0.0.1:18470

# Who Caddy believes when a request says, in X-Forwarded-Proto and
# X-Forwarded-For, that it came in over HTTPS and from whom: the front proxy
# or tunnel in front of the site. Caddy's spelling: private_ranges, or
# addresses and ranges separated by spaces.
SOLOCLEF_GO_TRUSTED_PROXIES=private_ranges

# Which optional services Compose starts. It is not a setting to change:
# the sandbox server's profile is made from the two sandbox switches
# (SOLOCLEF_API_SANDBOX_ENABLED, SOLOCLEF_WORKER_VIDEO_ENABLED), so it is
# `sandbox-true` exactly when one of them is true, and this line is what
# makes that profile start. Leave it as it is.
COMPOSE_PROFILES=sandbox-true

# The Docker network the model proxy (LiteLLM) is on. It must exist already;
# the stack joins it and never creates or removes it.
SOLOCLEF_GO_MODEL_NETWORK=litellm_default

# Memory ceilings for the two services that will take what they are offered
# (Docker's syntax: 512m, 2g).
SOLOCLEF_GO_QDRANT_MEMORY=2g
SOLOCLEF_GO_PARSE_MEMORY=2g

# ── Secrets ─────────────────────────────────────────────────────────────────

# A directory on the host holding one file a secret, named as below. Relative
# paths are relative to docker/. Make the directory 0700 and each file 0444:
# the services run as different users and each must be able to read its own.
#
#   postgres_password   the database password. It is written into a URL by
#                       two services, so use characters that need no escaping
#                       there:  openssl rand -hex 24
#   session_secret      the key session tokens are signed with:
#                       openssl rand -hex 32
#   litellm_key         a key the model proxy accepts
#   s3_access_key       MinIO's root user, at least 3 characters
#   s3_secret_key       MinIO's root password, at least 8 characters
#   sandbox_api_key     the sandbox server's key: openssl rand -hex 32.
#                       Needed only when a sandbox switch below is true;
#                       with both off the file need not exist
SOLOCLEF_GO_SECRETS_DIR=./secrets-go

# Where each of those files is inside a container. Compose mounts a secret at
# /run/secrets/<its name>, so these change only if the names above do.
SOLOCLEF_GO_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
SOLOCLEF_GO_SESSION_SECRET_FILE=/run/secrets/session_secret
SOLOCLEF_GO_LITELLM_KEY_FILE=/run/secrets/litellm_key
SOLOCLEF_GO_S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
SOLOCLEF_GO_S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key

# ── Stores ──────────────────────────────────────────────────────────────────

SOLOCLEF_GO_POSTGRES_USER=notes
SOLOCLEF_GO_POSTGRES_DB=notes

# The bucket every file is kept in, made at start if it is not there, and
# the region MinIO is told it is in (any name; clients must say the same).
SOLOCLEF_GO_S3_BUCKET=notes-files
SOLOCLEF_GO_S3_REGION=us-east-1

# The name searches address in Qdrant, and the collection behind it. The
# indexer creates the collection and points the alias at it; a new embedding
# choice is a new collection and the alias moved.
#
# The collection is divided by account: its tenant field is `user_id`. The
# indexer refuses one that was filled while documents belonged to
# workspaces (a collection with a `workspace_id` index), so a Qdrant volume
# kept from before must be given a name here that it does not have yet.
SOLOCLEF_GO_QDRANT_ALIAS=chunks
SOLOCLEF_INDEX_QDRANT_COLLECTION=chunks_by_user_v1

# The queue background jobs go on by default. The worker consumes it and its
# heavy sibling, `<this>.heavy`, which the Compose file builds from it, so
# the API and the worker cannot disagree about either name.
SOLOCLEF_GO_CELERY_DEFAULT_QUEUE=notes

# ── Models ──────────────────────────────────────────────────────────────────

# The model proxy's OpenAI-compatible root, ending in /v1, as reached on
# SOLOCLEF_GO_MODEL_NETWORK. Every model call goes through it.
SOLOCLEF_GO_LITELLM_URL=http://litellm:4000/v1

# The embedding choice, said three ways that must agree: the indexer's
# profile (soloclef_worker/internal/embedding lists them), and the proxy's
# name for that profile's model and the length of its vectors, which the API
# embeds questions with.
SOLOCLEF_EMBEDDING_PROFILE=bge-m3
SOLOCLEF_GO_EMBEDDING_MODEL=cloudflare-bge-m3
SOLOCLEF_GO_EMBEDDING_DIMENSION=1024

# The proxy's name for the model that answers in chat. The worker drafts a
# podcast with it too, for an account that chose no chat model of its own.
SOLOCLEF_API_CHAT_MODEL=example-chat-model

# The speech service podcasts are voiced with: `<roster>/<the proxy's model
# name>`. The first segment names the voices on offer (openai, azure or
# vertex_ai), except that a model whose name contains "kokoro" is always
# Kokoro's voices. The API offers that roster's voices and the worker speaks
# them, so both are given this one value.
SOLOCLEF_GO_TTS_SERVICE=openai/example-kokoro-tts

# ── The web app ─────────────────────────────────────────────────────────────

# How many sync processes zero-cache (the web app's live updates) runs. Each
# holds the open browser tabs it serves and takes memory and database
# connections; left to itself it starts one per CPU but one.
SOLOCLEF_GO_ZERO_SYNC_WORKERS=4

# ── The API ─────────────────────────────────────────────────────────────────

# debug, info, warn or error.
SOLOCLEF_API_LOG_LEVEL=info
# How long in-flight requests have after a stop signal.
SOLOCLEF_API_SHUTDOWN_GRACE_SECONDS=15
# This replica's share of Postgres connections.
SOLOCLEF_API_DATABASE_MAX_CONNECTIONS=10

# The site's public address and the web app's (the same, unless the app is
# served from another origin), the origins a browser may call the API from,
# and the contact page every error names.
SOLOCLEF_API_PUBLIC_URL=https://notes.example
SOLOCLEF_API_FRONTEND_URL=https://notes.example
SOLOCLEF_API_ALLOWED_ORIGINS=https://notes.example
SOLOCLEF_API_ERROR_REPORT_URL=https://notes.example/contact
# Whether the sign-in cookies carry Secure: always on a site served over
# https (a cookie without it can leak over plain http), auto only for a test
# stack on plain http, where auto follows the scheme the request came in on.
SOLOCLEF_API_SESSION_COOKIE_SECURE_POLICY=always
# The product's name, in the chat's system prompt, in refusals and in the
# password-reset mail.
SOLOCLEF_API_BRAND_NAME=Example Notes

# Whether people may make their own accounts: by the sign-up form, and by a
# first single sign-on with an address no account has. Exactly true or false;
# there is no default. With false the operator makes each account:
#   printf '%s\n' "$PASSWORD" | docker exec -i <api container> soloclef-api set-password person@example.org
# and names an administrator with
#   docker exec <api container> soloclef-api set-admin person@example.org true
SOLOCLEF_API_SIGNUP_ALLOWED=false

# Single sign-on through an OpenID Connect provider. Exactly true or false.
# It is off here.
SOLOCLEF_API_OIDC_ENABLED=false
# Read only when the switch above is true, and then all four are required
# (with SOLOCLEF_API_FRONTEND_URL above): the provider's issuer exactly as it
# prints it, this application's client id there, the file the client secret
# is in, and this API's callback as registered at the provider (the site's
# public address followed by /auth/oidc/callback). docker-compose.go.yml says
# how the secret is mounted. All four lines must stay.
#   SOLOCLEF_API_OIDC_ISSUER=https://sso.example/application/o/notes/
#   SOLOCLEF_API_OIDC_REDIRECT_URL=https://notes.example/auth/oidc/callback
SOLOCLEF_API_OIDC_ISSUER=
SOLOCLEF_API_OIDC_CLIENT_ID=
SOLOCLEF_API_OIDC_CLIENT_SECRET_FILE=
SOLOCLEF_API_OIDC_REDIRECT_URL=
# OPTIONAL: the words on the web app's single sign-on button. Empty is the
# app's own ("Continue with single sign-on"). The line must stay.
SOLOCLEF_WEB_SSO_BUTTON_LABEL=
# Read only with single sign-on on, and then the name is required: the
# provider as a sentence names it ("Example SSO"), and the phone app's return
# addresses, comma-separated ("soloclef://auth"; empty: the app may not use
# single sign-on). Both lines must stay.
SOLOCLEF_API_OIDC_DISPLAY_NAME=
SOLOCLEF_API_OIDC_APP_REDIRECTS=

# OPTIONAL, as a group: AI agents (claude.ai, ChatGPT) signing in at the
# identity provider to use the MCP server. Leave all three empty and only API
# keys work. Set, they are the provider's issuer for the agent application
# exactly as it prints it, that application's client id (given together), and
# the file its client secret is in, which may stay empty for a client that
# has none. All three lines must stay.
SOLOCLEF_API_AGENT_ISSUER=
SOLOCLEF_API_AGENT_CLIENT_ID=
SOLOCLEF_API_AGENT_CLIENT_SECRET_FILE=

# Whether the API sends mail: the password-reset link. Exactly true or false.
# It is off here, and "Forgot password?" then answers that resets are
# unavailable.
SOLOCLEF_API_SMTP_ENABLED=false
# Read only when the switch above is true. The host, the port, the security
# mode (starttls, tls or none; never guessed from the port), the sender and
# the timeout in seconds are then required. The username and the file its
# password is in are given together, or both left empty for a relay that
# takes none. All seven lines must stay.
SOLOCLEF_API_SMTP_HOST=
SOLOCLEF_API_SMTP_PORT=
SOLOCLEF_API_SMTP_SECURITY=
SOLOCLEF_API_SMTP_USERNAME=
SOLOCLEF_API_SMTP_PASSWORD_FILE=
SOLOCLEF_API_SMTP_FROM=
SOLOCLEF_API_SMTP_TIMEOUT_SECONDS=

# The address "Report Issue" mails go to, which the site shows to anyone.
# One plain address, or empty to publish none. The line must stay.
SOLOCLEF_API_SUPPORT_EMAIL=

# How a chat search uses the Qdrant collection. The indexer creates it
# quantized, so QUANTIZED is true; RESCORE scores the best candidates again
# against the full vectors, and OVERSAMPLING (at least 1) is how many times
# the wanted number are fetched for that. HNSW_EF is recall bought with time.
SOLOCLEF_API_QDRANT_SEARCH_HNSW_EF=200
SOLOCLEF_API_QDRANT_QUANTIZED=true
SOLOCLEF_API_QDRANT_SEARCH_RESCORE=true
SOLOCLEF_API_QDRANT_SEARCH_OVERSAMPLING=2.0

# What this deployment calls itself to PubMed, as NCBI asks every client to.
SOLOCLEF_API_NCBI_TOOL=example-notes
# OPTIONAL: a contact address for NCBI. It may be left empty, as may the
# others below that say OPTIONAL or "read only when"; each such line must
# still be there.
SOLOCLEF_API_NCBI_EMAIL=

# The bounds of one chat turn: how many steps it may take (a model call and
# the tool calls it asks for are steps) and how long it may run.
SOLOCLEF_API_CHAT_MAX_STEPS=24
SOLOCLEF_API_CHAT_MAX_TURN_SECONDS=600

# OPTIONAL, each on its own: the proxy's names for the model that draws
# images and infographics, and for the model that looks at pictures for an
# account that chose no vision model of its own (a photo attached to a
# question, an upload's pictures when vision is switched on for it, and a
# drawn infographic read back; the indexer is given it too). A built report
# or deck is measured, never looked at, so the sandbox needs neither.
# Empty means that ability is off. Both lines must stay.
SOLOCLEF_API_CHAT_IMAGE_MODEL=
SOLOCLEF_API_CHAT_VISION_MODEL=

# Whether reports, slides, spreadsheets and pages are built, in a sandbox
# on the stack's own OpenSandbox server, which this switch or the video
# switch below starts. Exactly true or false. It is off here. Switching it
# on also takes the sandbox_api_key file (Secrets, above); the sandbox
# image is the stack's own, built from docker/sandbox with the stack.
SOLOCLEF_API_SANDBOX_ENABLED=false
# Read only when the switch above is true, and then all five are required:
# one sandbox's CPU and memory in the
# server's own spelling (2, 6Gi), how long a sandbox outlives its last use
# (seconds, at least 60), the longest one command may run (seconds), and
# how many sandboxes one account may have at once. The server's address,
# its key's file, the image and the stack's label on its sandboxes are the
# Compose file's. All five lines must stay.
SOLOCLEF_API_SANDBOX_CPU=
SOLOCLEF_API_SANDBOX_MEMORY=
SOLOCLEF_API_SANDBOX_IDLE_TTL_SECONDS=
SOLOCLEF_API_SANDBOX_COMMAND_TIMEOUT_SECONDS=
SOLOCLEF_API_SANDBOX_MAX_PER_ACCOUNT=

# OPTIONAL: the voices a new podcast's speakers are given, in speaker order,
# in the service's own names (af_heart,am_adam). Empty takes the roster's
# order. The line must stay.
SOLOCLEF_API_TTS_PODCAST_VOICES=

# What an upload may carry: the largest file, in bytes (an upload, a folder
# upload and a Nextcloud import are all held to it), and the most files in
# one request. The API tells clients both. Keep the file size at or under
# PARSE_SERVICE_MAX_BYTES below, or the API will accept files the parser
# service then refuses.
SOLOCLEF_API_UPLOAD_MAX_FILE_BYTES=52428800
SOLOCLEF_API_UPLOAD_MAX_FILES=10

# How many seconds a note's indexing waits after the save that queued it (at
# least 1). Saves made while it waits queue nothing more, so a longer wait is
# fewer embedding calls for a note being typed, and a shorter one puts what
# was just written in front of the chat and the search box sooner.
SOLOCLEF_API_NOTE_INDEX_DELAY_SECONDS=15

# OPTIONAL, as a pair: the one Nextcloud server people connect to, and how
# many files are fetched from it at once. Leave both empty for a deployment
# with no Nextcloud (the import routes are then not offered); set both to
# offer it. Both lines must stay.
SOLOCLEF_API_NEXTCLOUD_BASE_URL=
SOLOCLEF_API_NEXTCLOUD_DOWNLOAD_CONCURRENCY=

# OPTIONAL, as a group: Google Drive. Leave all five empty for a deployment
# with no Drive (its routes then say so and connect nothing); set all of
# them, and SOLOCLEF_WORKER_GOOGLE_DRIVE_ENABLED=true above, to offer it.
# The first two are the Google project's OAuth client, given to the API and
# to the worker alike: the client id (…apps.googleusercontent.com) and the
# file its secret is in (a secret a deployment adds to both services in an
# override of its own). Then the redirect URI registered for that client,
# which must be this API's address followed by
# /api/v1/auth/google/drive/connector/callback; the browser key the Google
# Picker runs with; and the Cloud project number, which may stay empty when
# it is the number the client id begins with. Every line must stay.
SOLOCLEF_GO_GOOGLE_OAUTH_CLIENT_ID=
SOLOCLEF_GO_GOOGLE_OAUTH_CLIENT_SECRET_FILE=
SOLOCLEF_API_GOOGLE_DRIVE_REDIRECT_URI=
SOLOCLEF_API_GOOGLE_PICKER_API_KEY=
SOLOCLEF_API_GOOGLE_PICKER_APP_ID=

# OPTIONAL, as a group: signing a Microsoft mailbox in for IMAP. Leave all
# four empty to offer app passwords only. Set, they are the Entra app
# registration's client id, the file its secret is in, the tenant (common,
# organizations, consumers, a tenant id or a verified domain; there is no
# default), and the redirect URI registered there, which must be this API's
# address followed by /api/v1/auth/microsoft/mail/connector/callback. Every
# line must stay.
SOLOCLEF_API_MICROSOFT_MAIL_CLIENT_ID=
SOLOCLEF_API_MICROSOFT_MAIL_CLIENT_SECRET_FILE=
SOLOCLEF_API_MICROSOFT_MAIL_TENANT=
SOLOCLEF_API_MICROSOFT_MAIL_REDIRECT_URI=

# ── The indexer ─────────────────────────────────────────────────────────────

# Documents indexed at once.
SOLOCLEF_GO_INDEX_CONCURRENCY=4
# Go durations (30s, 2m). One embedding request; one Qdrant request.
SOLOCLEF_INDEX_EMBEDDING_TIMEOUT=2m
SOLOCLEF_INDEX_QDRANT_TIMEOUT=30s
# How often a failure that may pass (the proxy busy, a store restarting) is
# tried in all, and how long between tries.
SOLOCLEF_INDEX_MAX_ATTEMPTS=3
SOLOCLEF_INDEX_RETRY_DELAY=30s

# The parsers. These five are given to the indexer AND the API, unchanged:
# the API accepts a parser for a file, the indexer runs it.
#
# The parser a document gets when neither its upload nor its connection
# chose one. `local` is the parser service in this stack.
SOLOCLEF_PARSER_DEFAULT=local
# The largest plain-text file read whole, and the largest Markdown a parser
# may hand back, in bytes.
SOLOCLEF_PARSE_MAX_TEXT_BYTES=10485760
SOLOCLEF_PARSE_MAX_MARKDOWN_BYTES=52428800
# How long the indexer waits for the parser service to answer one file.
SOLOCLEF_PARSE_SERVICE_TIMEOUT_SECONDS=120

# ── The parser service ──────────────────────────────────────────────────────

# Parser processes kept warm, which is also how many files parse at once.
PARSE_SERVICE_WORKERS=2
# The largest file accepted, in bytes.
PARSE_SERVICE_MAX_BYTES=52428800
# The longest one parse may run before its process is killed, and the
# longest a request waits for a free process before it is told to retry.
PARSE_SERVICE_PARSE_TIMEOUT_SECONDS=120
PARSE_SERVICE_QUEUE_WAIT_SECONDS=60

# ── The worker ──────────────────────────────────────────────────────────────

# Jobs run at once on the default queue (a notebook's name, a folder's or an
# account's removal) and on the heavy one (a podcast, drafted and voiced).
SOLOCLEF_GO_WORKER_CONCURRENCY=2
SOLOCLEF_GO_WORKER_HEAVY_CONCURRENCY=1
# The proxy's name for the model short calls are made with: a notebook's
# name.
SOLOCLEF_WORKER_QUICK_MODEL=example-quick-model
# Go durations (90s, 5m). One model call, its retries included.
SOLOCLEF_WORKER_LLM_CALL_TIMEOUT=5m
# OPTIONAL: the speaking style, for a model that takes one (gpt-4o-mini-tts
# does). Empty is no style. The line must stay.
SOLOCLEF_WORKER_TTS_INSTRUCTIONS=
# How long one spoken line may take, how many requests it may cost, and how
# many lines one podcast voices at once.
SOLOCLEF_WORKER_TTS_ATTEMPT_TIMEOUT=90s
SOLOCLEF_WORKER_TTS_MAX_ATTEMPTS=3
SOLOCLEF_WORKER_TTS_CONCURRENCY=8
# One Qdrant request, when a removal deletes a document's points.
SOLOCLEF_WORKER_QDRANT_TIMEOUT=30s

# Whether automations run: saved agent tasks on a schedule, on a document
# arriving in a folder, or started by hand. Exactly true or false. False, a
# run that is asked for is ended at once with a reason. Everything else an
# automation needs (the embedding model, the search settings, the brand, the
# step limit, the picture models, the sandbox, the Microsoft mail and Google
# registrations) is the API's own setting, which the compose file hands to
# the worker as well, so there is nothing more to set here. An automation
# may email its result only where SOLOCLEF_API_SMTP_ENABLED is true.
SOLOCLEF_WORKER_AUTOMATIONS_ENABLED=true

# Whether videos are rendered, in a sandbox on the stack's own OpenSandbox
# server (the reports' switch above says what switching it on takes).
# Exactly true or false. False, every video asked for is marked failed at
# once with a reason. It is off here.
SOLOCLEF_WORKER_VIDEO_ENABLED=false
# Read only when the switch above is true, and then all are required but the
# narration's style: one sandbox's CPU and memory in the server's own spelling
# (2, 6Gi), how long a sandbox outlives its last use and the longest one
# command may run (Go durations), the longest one render step may run, the
# render mode (frames or stills), frames rendered at once, frames in one
# encoded segment, the longest one frame may take, renders this worker runs
# at once, the narration's voice id from SOLOCLEF_GO_TTS_SERVICE's roster
# (kokoro:af_heart), and its speaking style. Every line must stay.
SOLOCLEF_WORKER_VIDEO_SANDBOX_CPU=
SOLOCLEF_WORKER_VIDEO_SANDBOX_MEMORY=
SOLOCLEF_WORKER_VIDEO_SANDBOX_IDLE_TTL=
SOLOCLEF_WORKER_VIDEO_SANDBOX_COMMAND_TIMEOUT=
SOLOCLEF_WORKER_VIDEO_RENDER_TIMEOUT=
SOLOCLEF_WORKER_VIDEO_RENDER_MODE=
SOLOCLEF_WORKER_VIDEO_RENDER_CONCURRENCY=
SOLOCLEF_WORKER_VIDEO_FRAMES_PER_SEGMENT=
SOLOCLEF_WORKER_VIDEO_FRAME_TIMEOUT=
SOLOCLEF_WORKER_VIDEO_MAX_RENDERS=
SOLOCLEF_WORKER_VIDEO_NARRATION_VOICE=
SOLOCLEF_WORKER_VIDEO_NARRATION_INSTRUCTIONS=

# Whether the worker keeps imported Google Drive files in step with Drive.
# Exactly true or false: true on a deployment that has set Drive up (the
# SOLOCLEF_GO_GOOGLE_* and SOLOCLEF_API_GOOGLE_* settings below), false on
# one that has not. It is off here.
SOLOCLEF_WORKER_GOOGLE_DRIVE_ENABLED=false
# Read only when the switch above is true, and then required: how many files
# one sync reads from Drive at once (4). The line must stay.
SOLOCLEF_WORKER_GOOGLE_DRIVE_CONCURRENCY=
