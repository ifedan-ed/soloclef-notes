# =============================================================================
# Soloclef Notes — Docker Compose
# =============================================================================
# Every app image is built here from this checkout; none is pulled from
# upstream SurfSense. docker-compose.override.yml holds one host's shape
# (loopback proxy port, log rotation, LiteLLM and MCP networks); on any other
# host pass `-f docker-compose.yml` (plus your own override) so Compose does
# not read it. Nothing in this file names a server: the address, contact and
# sign-in come from docker/.env (surfsense_web/content/docs/self-hosting.mdx).
#
#   docker build -t soloclef-backend-src:latest --target production ../surfsense_backend
#   docker build -t soloclef-backend-fast:latest ../custom
#   docker compose -f docker-compose.yml -f docker-compose.override.yml build sandbox-image frontend
#   python3 ../surfsense_backend/scripts/deploy_gate.py --wait && \
#     docker compose -f docker-compose.yml -f docker-compose.override.yml up -d
# =============================================================================

name: soloclef

# Postgres and Redis are reached by CONTAINER name (soloclef-db-1,
# soloclef-redis-1), never by the bare service names "db" and "redis": an
# override may join the backend and Celery to a LiteLLM network (this host's
# does), where LiteLLM's own Postgres and Redis answer to "db" and "redis". A bare name
# resolved there on 2026-09-26 and the app tried LiteLLM's database.

# Every app process reaches Postgres through pgbouncer (docker/pgbouncer/, and
# custom/README.md "pgbouncer"). `migrations` and `zero-cache` are the two
# exceptions and keep the direct DATABASE_URL below: Alembic takes session
# advisory locks and runs DDL, and zero-cache needs logical replication, which
# transaction pooling cannot carry.
#
# To bypass the pooler, set DATABASE_URL_DIRECT in docker/.env to the direct
# URL and DB_PGBOUNCER_TRANSACTION_POOLING=FALSE. Both have to move together:
# pgbouncer closes the connection if asyncpg asks for
# idle_in_transaction_session_timeout in the startup packet, and a direct
# Postgres leaves the app with no idle-transaction reaper if it does not.
x-pooled-database: &pooled-database
  DATABASE_URL: ${DATABASE_URL_DIRECT:-postgresql+asyncpg://${DB_USER:-surfsense}:${DB_PASSWORD:-surfsense}@${DB_POOLER_HOST:-soloclef-pgbouncer-1}:${DB_POOLER_PORT:-6432}/${DB_NAME:-surfsense}}
  DB_PGBOUNCER_TRANSACTION_POOLING: ${DB_PGBOUNCER_TRANSACTION_POOLING:-TRUE}

services:
  db:
    image: pgvector/pgvector:pg17
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./postgresql.conf:/etc/postgresql/postgresql.conf:ro
    environment:
      POSTGRES_USER: ${DB_USER:-surfsense}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-surfsense}
      POSTGRES_DB: ${DB_NAME:-surfsense}
    command: postgres -c config_file=/etc/postgresql/postgresql.conf
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-surfsense} -d ${DB_NAME:-surfsense}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # The app's connection multiplexer. In transaction pooling mode a client
  # connection only holds a Postgres connection for the length of a
  # transaction, so the API's idle pooled connections (one pool per uvicorn
  # worker, DB_POOL_SIZE + DB_MAX_OVERFLOW each, plus the LangGraph
  # checkpointer's) and every short-lived Celery connection share far fewer
  # than the server's 200. That is what lets this stack run more API replicas.
  # Pool sizes, timeouts and the reasoning are in pgbouncer.ini.template;
  # render-config.sh fills it in from these settings at start, so no credential
  # is in the repository and none is in the rendered config either.
  pgbouncer:
    image: edoburu/pgbouncer:v1.26.1-p0
    expose:
      - "6432"
    volumes:
      - ./pgbouncer/pgbouncer.ini.template:/etc/pgbouncer/pgbouncer.ini.template:ro
      - ./pgbouncer/render-config.sh:/usr/local/bin/render-pgbouncer-config:ro
    entrypoint: ["/usr/local/bin/render-pgbouncer-config"]
    environment:
      DB_HOST: ${DB_HOST:-soloclef-db-1}
      DB_PORT: ${DB_PORT:-5432}
      DB_NAME: ${DB_NAME:-surfsense}
      DB_USER: ${DB_USER:-surfsense}
      DB_PASSWORD: ${DB_PASSWORD:-surfsense}
      PGBOUNCER_PORT: "6432"
    # max_client_conn 1000 needs ~1130 descriptors; the stock 1024 soft limit
    # would have pgbouncer refusing clients at the top of a burst.
    ulimits:
      nofile:
        soft: 8192
        hard: 8192
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    # End to end on purpose: a pooler that answers but cannot reach Postgres
    # (a restarted `db` with a new address, say) is not healthy. It recovers on
    # its own within server_login_retry once the database is back.
    healthcheck:
      test:
        - CMD-SHELL
        - PGPASSWORD="$$DB_PASSWORD" PGCONNECT_TIMEOUT=3 psql -h 127.0.0.1 -p 6432
          -U "$$DB_USER" -d "$$DB_NAME" -At --no-password -c 'SELECT 1' > /dev/null
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  # Short-lived schema runner. Executes `alembic upgrade head` and verifies
  # that the `zero_publication` Postgres logical-replication publication
  # matches the canonical shape, then exits 0. Downstream services gate on this
  # with `condition: service_completed_successfully` so a failed migration halts
  # the whole stack instead of booting zero-cache against a drifted publication.
  migrations:
    image: soloclef-backend-fast:latest
    env_file:
      - .env
    environment:
      DATABASE_URL: ${DATABASE_URL:-postgresql+asyncpg://${DB_USER:-surfsense}:${DB_PASSWORD:-surfsense}@${DB_HOST:-soloclef-db-1}:${DB_PORT:-5432}/${DB_NAME:-surfsense}}
      PYTHONPATH: /app
      SERVICE_ROLE: migrate
      MIGRATION_TIMEOUT: ${MIGRATION_TIMEOUT:-900}
    depends_on:
      db:
        condition: service_healthy
    restart: "no"

  redis:
    image: redis:8-alpine
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  searxng:
    image: searxng/searxng:2026.3.13-3c1f68c59
    volumes:
      - ./searxng:/etc/searxng
    environment:
      SEARXNG_SECRET: ${SEARXNG_SECRET:-surfsense-searxng-secret}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8080/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Spawns sandbox containers on the host daemon as siblings, so it needs the
  # socket. Its own config path is baked into the image's CMD.
  opensandbox-server:
    image: opensandbox/server:v0.2.2
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./opensandbox/sandbox.toml:/etc/opensandbox/config.toml:ro
      - opensandbox_data:/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      OPENSANDBOX_SERVER_API_KEY: ${OPENSANDBOX_API_KEY:-surfsense-dev-sandbox}
    mem_limit: ${OPENSANDBOX_SERVER_MEMORY_LIMIT:-512m}
    restart: unless-stopped
    # The runtime image ships neither curl nor wget; python is on PATH.
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3).status == 200 else 1)"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s

  # Never starts. Exists so `docker compose pull` warms the sandbox image, which
  # opensandbox-server would otherwise pull inside the first create call.
  sandbox-image:
    image: soloclef-sandbox-local:latest
    build:
      context: ./sandbox
    deploy:
      replicas: 0

  # Single public entry point for the Docker stack. Comment this service out
  # only if you front SurfSense with your own reverse proxy.
  proxy:
    image: caddy:2-alpine
    # For DNS-01/wildcard certificates, replace image with:
    # build: ./proxy
    restart: unless-stopped
    ports:
      - "${LISTEN_HTTP_PORT:-3929}:80"
      - "${LISTEN_HTTPS_PORT:-443}:443"
    volumes:
      - ./proxy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    environment:
      SURFSENSE_SITE_ADDRESS: ${SURFSENSE_SITE_ADDRESS:-:80}
      CERT_EMAIL: ${CERT_EMAIL:-}
      CERT_ACME_CA: ${CERT_ACME_CA:-https://acme-v02.api.letsencrypt.org/directory}
      CERT_ACME_DNS: ${CERT_ACME_DNS:-}
      TRUSTED_PROXIES: ${TRUSTED_PROXIES:-0.0.0.0/0}
      SURFSENSE_MAX_BODY_SIZE: ${SURFSENSE_MAX_BODY_SIZE:-5GB}
    depends_on:
      frontend:
        condition: service_started
      backend:
        condition: service_healthy
      zero-cache:
        condition: service_healthy

  backend:
    image: soloclef-backend-fast:latest
    expose:
      - "8000"
    volumes:
      - shared_temp:/shared_tmp
      - object_store:/app/.local_object_store
    env_file:
      - .env
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      <<: *pooled-database
      CELERY_BROKER_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_RESULT_BACKEND: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      REDIS_APP_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_TASK_DEFAULT_QUEUE: surfsense
      PYTHONPATH: /app
      UVICORN_LOOP: asyncio
      UNSTRUCTURED_HAS_PATCHED_LOOP: "1"
      FILE_STORAGE_LOCAL_PATH: /app/.local_object_store
      NEXT_FRONTEND_URL: ${NEXT_FRONTEND_URL:-${SURFSENSE_PUBLIC_URL:-http://localhost:${LISTEN_HTTP_PORT:-3929}}}
      BACKEND_URL: ${BACKEND_URL:-${SURFSENSE_PUBLIC_URL:-http://localhost:${LISTEN_HTTP_PORT:-3929}}}
      SEARXNG_URL: ${SEARXNG_URL:-http://searxng:8080}
      MAX_FILE_SIZE_MB: ${MAX_FILE_SIZE_MB:-500}
      SANDBOX_ENABLED: ${SANDBOX_ENABLED:-TRUE}
      SANDBOX_PROVIDER: ${SANDBOX_PROVIDER:-opensandbox}
      OPENSANDBOX_DOMAIN: ${OPENSANDBOX_DOMAIN:-opensandbox-server:8080}
      OPENSANDBOX_API_KEY: ${OPENSANDBOX_API_KEY:-surfsense-dev-sandbox}
      SANDBOX_IMAGE: ${SANDBOX_IMAGE:-soloclef-sandbox-local:latest}
      SERVICE_ROLE: api
    depends_on:
      db:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
      migrations:
        condition: service_completed_successfully
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/ready"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 200s

  celery_worker:
    image: soloclef-backend-fast:latest
    volumes:
      - shared_temp:/shared_tmp
      - object_store:/app/.local_object_store
    env_file:
      - .env
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      <<: *pooled-database
      CELERY_BROKER_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_RESULT_BACKEND: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      REDIS_APP_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_TASK_DEFAULT_QUEUE: surfsense
      PYTHONPATH: /app
      FILE_STORAGE_LOCAL_PATH: /app/.local_object_store
      SEARXNG_URL: ${SEARXNG_URL:-http://searxng:8080}
      SANDBOX_ENABLED: ${SANDBOX_ENABLED:-TRUE}
      SANDBOX_PROVIDER: ${SANDBOX_PROVIDER:-opensandbox}
      OPENSANDBOX_DOMAIN: ${OPENSANDBOX_DOMAIN:-opensandbox-server:8080}
      OPENSANDBOX_API_KEY: ${OPENSANDBOX_API_KEY:-surfsense-dev-sandbox}
      SANDBOX_IMAGE: ${SANDBOX_IMAGE:-soloclef-sandbox-local:latest}
      SERVICE_ROLE: worker
      # The fast and connector queues; long generation has celery_heavy.
      CELERY_QUEUES: surfsense,surfsense.connectors
      CELERY_MAX_WORKERS: ${CELERY_FAST_MAX_WORKERS:-16}
      CELERY_MIN_WORKERS: ${CELERY_FAST_MIN_WORKERS:-2}
    depends_on:
      db:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
      migrations:
        condition: service_completed_successfully
      backend:
        condition: service_healthy
    restart: unless-stopped

  # Podcasts, video presentations and Studio deliverables (the surfsense.heavy
  # queue, app/celery_app.py HEAVY_TASKS): minutes each, so they get processes
  # of their own and a burst of them never holds up uploads or chat.
  celery_heavy:
    image: soloclef-backend-fast:latest
    volumes:
      - shared_temp:/shared_tmp
      - object_store:/app/.local_object_store
    env_file:
      - .env
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      <<: *pooled-database
      CELERY_BROKER_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_RESULT_BACKEND: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      REDIS_APP_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_TASK_DEFAULT_QUEUE: surfsense
      PYTHONPATH: /app
      FILE_STORAGE_LOCAL_PATH: /app/.local_object_store
      SEARXNG_URL: ${SEARXNG_URL:-http://searxng:8080}
      SANDBOX_ENABLED: ${SANDBOX_ENABLED:-TRUE}
      SANDBOX_PROVIDER: ${SANDBOX_PROVIDER:-opensandbox}
      OPENSANDBOX_DOMAIN: ${OPENSANDBOX_DOMAIN:-opensandbox-server:8080}
      OPENSANDBOX_API_KEY: ${OPENSANDBOX_API_KEY:-surfsense-dev-sandbox}
      SANDBOX_IMAGE: ${SANDBOX_IMAGE:-soloclef-sandbox-local:latest}
      SERVICE_ROLE: worker
      CELERY_QUEUES: surfsense.heavy
      CELERY_MAX_WORKERS: ${CELERY_HEAVY_MAX_WORKERS:-4}
      CELERY_MIN_WORKERS: ${CELERY_HEAVY_MIN_WORKERS:-1}
    depends_on:
      db:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
      migrations:
        condition: service_completed_successfully
      backend:
        condition: service_healthy
    restart: unless-stopped

  # Delivers queued email (app/mail_queue, custom/docs/mail-queue.md):
  # MAIL_SENDERS senders over MAIL_TRANSPORT, both required in .env. Exactly
  # one of these runs; it restarts without touching chat or generation.
  mail_sender:
    image: soloclef-backend-fast:latest
    env_file:
      - .env
    environment:
      <<: *pooled-database
      REDIS_APP_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      PYTHONPATH: /app
      SERVICE_ROLE: mail
    depends_on:
      redis:
        condition: service_healthy
    stop_grace_period: 60s
    restart: unless-stopped

  celery_beat:
    image: soloclef-backend-fast:latest
    env_file:
      - .env
    environment:
      <<: *pooled-database
      CELERY_BROKER_URL: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_RESULT_BACKEND: ${REDIS_URL:-redis://soloclef-redis-1:6379/0}
      CELERY_TASK_DEFAULT_QUEUE: surfsense
      PYTHONPATH: /app
      SERVICE_ROLE: beat
    depends_on:
      db:
        condition: service_healthy
      pgbouncer:
        condition: service_healthy
      redis:
        condition: service_healthy
      migrations:
        condition: service_completed_successfully
      celery_worker:
        condition: service_started
    restart: unless-stopped

  zero-cache:
    image: rocicorp/zero:1.6.0
    expose:
      - "4848"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      ZERO_UPSTREAM_DB: ${ZERO_UPSTREAM_DB:-postgresql://${DB_USER:-surfsense}:${DB_PASSWORD:-surfsense}@${DB_HOST:-soloclef-db-1}:${DB_PORT:-5432}/${DB_NAME:-surfsense}?sslmode=${DB_SSLMODE:-disable}}
      ZERO_CVR_DB: ${ZERO_CVR_DB:-postgresql://${DB_USER:-surfsense}:${DB_PASSWORD:-surfsense}@${DB_HOST:-soloclef-db-1}:${DB_PORT:-5432}/${DB_NAME:-surfsense}?sslmode=${DB_SSLMODE:-disable}}
      ZERO_CHANGE_DB: ${ZERO_CHANGE_DB:-postgresql://${DB_USER:-surfsense}:${DB_PASSWORD:-surfsense}@${DB_HOST:-soloclef-db-1}:${DB_PORT:-5432}/${DB_NAME:-surfsense}?sslmode=${DB_SSLMODE:-disable}}
      ZERO_REPLICA_FILE: /data/zero.db
      ZERO_ADMIN_PASSWORD: ${ZERO_ADMIN_PASSWORD:-surfsense-zero-admin}
      ZERO_APP_PUBLICATIONS: ${ZERO_APP_PUBLICATIONS:-zero_publication}
      ZERO_AUTO_RESET: ${ZERO_AUTO_RESET:-true}
      ZERO_NUM_SYNC_WORKERS: ${ZERO_NUM_SYNC_WORKERS:-4}
      ZERO_UPSTREAM_MAX_CONNS: ${ZERO_UPSTREAM_MAX_CONNS:-20}
      ZERO_CVR_MAX_CONNS: ${ZERO_CVR_MAX_CONNS:-30}
      ZERO_QUERY_URL: ${ZERO_QUERY_URL:-http://frontend:3000/api/zero/query}
      ZERO_MUTATE_URL: ${ZERO_MUTATE_URL:-http://frontend:3000/api/zero/mutate}
      ZERO_QUERY_FORWARD_COOKIES: ${ZERO_QUERY_FORWARD_COOKIES:-true}
      ZERO_QUERY_API_KEY: ${ZERO_QUERY_API_KEY:-}
      ZERO_AUTH_REVALIDATE_INTERVAL_SECONDS: ${ZERO_AUTH_REVALIDATE_INTERVAL_SECONDS:-60}
      ZERO_AUTH_RETRANSFORM_INTERVAL_SECONDS: ${ZERO_AUTH_RETRANSFORM_INTERVAL_SECONDS:-60}
    volumes:
      - zero_cache_data:/data
    restart: unless-stopped
    stop_grace_period: 300s
    depends_on:
      db:
        condition: service_healthy
      migrations:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:4848/keepalive"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 600s

  # The MCP server ("Connect your agent"): streamable HTTP at /mcp through the
  # bundled proxy. It holds no secret; every request carries the caller's own
  # API key (ss_pat_...) or, from claude.ai and ChatGPT, an Authentik sign-in
  # token, and the backend checks it and the workspace's API access on every
  # tool call. MCP_OAUTH_ISSUER (shared with the backend, which also needs
  # MCP_OAUTH_CLIENT_ID) turns the sign-in on; unset, only API keys work.
  mcp:
    image: soloclef-mcp-local:latest
    build:
      context: ../surfsense_mcp
      target: production
    expose:
      - "8080"
    environment:
      SURFSENSE_BASE_URL: http://backend:8000
      SURFSENSE_PUBLIC_URL: ${SURFSENSE_PUBLIC_URL:-}
      MCP_OAUTH_ISSUER: ${MCP_OAUTH_ISSUER:-}
      # Optional; empty keeps the defaults in surfsense_mcp/mcp_server/config.py
      # (${SURFSENSE_PUBLIC_URL}/mcp; openid email profile offline_access).
      SURFSENSE_MCP_PUBLIC_URL: ${SURFSENSE_MCP_PUBLIC_URL:-}
      MCP_OAUTH_SCOPES: ${MCP_OAUTH_SCOPES:-}
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: unless-stopped

  frontend:
    image: soloclef-web-local:latest
    build:
      context: ../surfsense_web
      dockerfile: Dockerfile
      target: runner
      # Printed into the prerendered public pages (surfsense_web/Dockerfile):
      # the site's address, its contact and the docs' sign-in wording, from
      # the same docker/.env lines the backend reads. Rebuild after changing.
      args:
        NEXT_PUBLIC_SITE_URL: ${NEXT_PUBLIC_SITE_URL:-${SURFSENSE_PUBLIC_URL:-}}
        NEXT_PUBLIC_SUPPORT_EMAIL: ${SUPPORT_EMAIL:-}
        NEXT_PUBLIC_OIDC_ENABLED: ${OIDC_ENABLED:-FALSE}
        NEXT_PUBLIC_OIDC_BUTTON_LABEL: ${OIDC_BUTTON_LABEL:-}
        NEXT_PUBLIC_OIDC_DISCOVERY_URL: ${OIDC_DISCOVERY_URL:-}
        NEXT_PUBLIC_OIDC_AUTOCREATE_DOMAINS: ${OIDC_AUTOCREATE_DOMAINS:-}
        NEXT_PUBLIC_OIDC_ALLOW_SIGNUP: ${OIDC_ALLOW_SIGNUP:-FALSE}
        # Create an account (true) or Request access (anything else) on the
        # website (surfsense_web/lib/signups.ts). The backend reads the same
        # line through env_file for GET /api/v1/sign-in-options, which the
        # phone app follows, so both offer the same thing.
        NEXT_PUBLIC_SIGNUPS_OPEN: ${NEXT_PUBLIC_SIGNUPS_OPEN:-}
    expose:
      - "3000"
    environment:
      AUTH_TYPE: ${AUTH_TYPE:-LOCAL}
      # The upload dialog's file list until GET /api/v1/etl/capabilities answers,
      # from the same parser lines the backend reads through env_file
      # (surfsense_web/lib/etl/fallback-service.ts). ETL_SERVICE is deprecated
      # and counts only while ETL_CLOUD_SERVICE is unset.
      ETL_DEFAULT_PARSER: ${ETL_DEFAULT_PARSER:-}
      ETL_CLOUD_SERVICE: ${ETL_CLOUD_SERVICE:-}
      ETL_SERVICE: ${ETL_SERVICE:-}
      DEPLOYMENT_MODE: ${DEPLOYMENT_MODE:-self-hosted}
      SURFSENSE_BACKEND_INTERNAL_URL: http://backend:8000
      MAX_FILE_SIZE_MB: ${MAX_FILE_SIZE_MB:-500}
      # The "single sign-on" button on /login. The backend reads the same
      # OIDC_ENABLED (and the rest of OIDC_*) from .env; keep them together.
      OIDC_ENABLED: ${OIDC_ENABLED:-FALSE}
      OIDC_BUTTON_LABEL: ${OIDC_BUTTON_LABEL:-}
    depends_on:
      backend:
        condition: service_healthy
      zero-cache:
        condition: service_healthy
    restart: unless-stopped

volumes:
  postgres_data:
    name: soloclef-postgres
  redis_data:
    name: soloclef-redis
  shared_temp:
    name: soloclef-shared-temp
  object_store:
    name: soloclef-object-store
  zero_cache_data:
    name: soloclef-zero-cache
  caddy_data:
    name: soloclef-caddy-data
  caddy_config:
    name: soloclef-caddy-config
  opensandbox_data:
    name: soloclef-opensandbox

# The network has a fixed name: the Nextcloud folder uploader
# (../../nextcloud-surfsense) joins it from its own compose project.
networks:
  default:
    name: soloclef_default
