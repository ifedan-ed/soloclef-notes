# Copy to .env (or set these in your MCP client config) and fill in your token.

# API key from Soloclef (Settings -> API). Required.
SOLOCLEF_API_KEY=ss_pat_your_token_here

# Base URL of the Soloclef backend. Defaults to http://localhost:8000
SOLOCLEF_BASE_URL=http://localhost:8000

# Optional: default workspace (search space) by name or id, so you don't have
# to select one each session.
# SOLOCLEF_WORKSPACE=My Research Space

# Optional overrides.
# SOLOCLEF_API_PREFIX=/api/v1
# SOLOCLEF_TIMEOUT=180
# SOLOCLEF_MCP_TRANSPORT=stdio

# Remote (streamable-http) only: agent sign-in for claude.ai and ChatGPT.
# The Authentik issuer, exactly as it prints it (trailing slash included).
# Unset: only API keys are accepted.
# MCP_OAUTH_ISSUER=https://sso.example.com/application/o/soloclef-mcp/
# This server's public address, as people paste it (default: SOLOCLEF_PUBLIC_URL + /mcp).
# SOLOCLEF_MCP_PUBLIC_URL=https://notes.example.com/mcp
# MCP_OAUTH_SCOPES=openid email profile offline_access
