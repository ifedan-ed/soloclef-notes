# Credentials kept beside the stack. Never commit these.
browserbase-key.txt
oidc-client-secret.txt
surfsense-litellm-key.txt
plans/**/__pycache__/

# Timestamped copies of docker/.env hold every secret the live one does.
.env.backup-*
.env.bak*

# Database dumps taken before local migrations; never committed.
docker/backups/

# Any copy of an env file holds secrets (backups, pre-rotation snapshots).
.env.*
!.env.example
# The Go stack's example settings (docker/docker-compose.go.yml) are example
# values only and are kept; its secret files never are.
!.env.go.example
docker/secrets-go/

# Build output and caches, matched anywhere rather than per module. Each
# module carries its own .gitignore, which is why these were never here --
# and why a `git add -A` from the root once committed 8,614 files of
# surfsense_web/.next, __pycache__ and 170 stored documents out of the
# pre-rename directories, which had lost their .gitignore in the rename.
# Anchored patterns cannot protect a directory that no longer exists in
# the layout; these can.
__pycache__/
*.py[cod]
*.egg-info/
.next/
.source/
next-env.d.ts
*.tsbuildinfo
.ruff_cache/
.pytest_cache/

# Documents a dev run stored on the host. The deployed app keeps these in
# a docker volume; a checkout should never carry anyone's uploads.
.local_object_store/

# The API binary go build ./cmd/api writes here; never tracked.
/soloclef_api/api
