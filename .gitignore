.env
node_modules/
.ruff_cache/
.venv
.pnpm-store
.DS_Store
debug.log

references/
references
specs/

# Playwright (E2E test artifacts)
soloclef_web/playwright/.auth/
soloclef_web/playwright-report/
soloclef_web/test-results/
soloclef_web/blob-report/

