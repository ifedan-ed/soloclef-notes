{
 "route": "GET /api/v1/workspaces/{workspace_id}/memory",
 "why": "The same document on a workspace rather than an account, so the RBAC gate is in front of it.",
 "parameters": {
  "workspace_id": 1
 },
 "matrices": [
  "credentials",
  "identifiers:workspace_id",
  "origins"
 ],
 "cases": [
  {
   "label": "read the team memory",
   "as": "owner",
   "path": "/api/v1/workspaces/1/memory"
  },
  {
   "label": "GET the team's memory",
   "as": "owner",
   "path": "/api/v1/workspaces/1/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET the team's memory as a plain member",
   "as": "scribe",
   "path": "/api/v1/workspaces/1/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET the team's memory as a member with no role",
   "as": "bare",
   "path": "/api/v1/workspaces/1/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET the team's memory as an outsider",
   "as": "outsider",
   "path": "/api/v1/workspaces/1/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET a workspace that is not there",
   "as": "owner",
   "path": "/api/v1/workspaces/999/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET a workspace whose memory is empty",
   "as": "owner",
   "path": "/api/v1/workspaces/2/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET workspace_id=abc",
   "as": "owner",
   "path": "/api/v1/workspaces/abc/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET workspace_id past int32",
   "as": "owner",
   "path": "/api/v1/workspaces/2200000000/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET workspace_id past int64",
   "as": "owner",
   "path": "/api/v1/workspaces/99999999999999999999/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET workspace_id 1_000",
   "as": "owner",
   "path": "/api/v1/workspaces/1_000/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET the team's memory with an API key on a gated workspace",
   "as": "key_owner",
   "path": "/api/v1/workspaces/1/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET the team's memory with an API key on an open workspace",
   "as": "key_owner",
   "path": "/api/v1/workspaces/2/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  },
  {
   "label": "GET the team's memory with no credential",
   "as": "none",
   "path": "/api/v1/workspaces/1/memory",
   "headers": {
    "Content-Type": "application/json"
   }
  }
 ]
}
