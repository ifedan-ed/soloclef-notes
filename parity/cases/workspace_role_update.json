 "parameters": {
  "workspace_id": 1,
  "role_id": 3
 },
 "headers": {
  "Content-Type": "application/json"
 },
 "body": "{\"name\": \"Scribe II\"}",
 "tables": [
  "workspace_roles",
  "workspace_memberships"
 ],
 "mint": true,
 "matrices": [
  "credentials",
  "identifiers:workspace_id",
  "identifiers:role_id",
  "cross_site"
 ],
 "bodies": [
  {
   "label": "a rename",
   "body": "{\"name\": \"Scribe II\"}"
  },
  {
   "label": "nothing to change",
   "body": "{}"
  },
  {
   "label": "a name already used in this workspace",
   "body": "{\"name\": \"Reader\"}"
  },
  {
   "label": "a name one character past the column",
