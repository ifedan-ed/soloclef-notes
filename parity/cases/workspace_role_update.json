  },
  {
   "label": "a rollback: becoming the default with a name the column cannot hold",
   "body": "{\"name\": \"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\", \"is_default\": true}"
  },
  {
   "label": "becoming the default",
   "body": "{\"is_default\": true}"
  },
  {
   "label": "an extra undeclared field",
   "body": "{\"name\": \"Scribe II\", \"nobody_declared_this\": 1}"
  },
  {
   "label": "permissions replaced wholesale",
   "body": "{\"permissions\": [\"logs:read\"]}"
  },
  {
   "label": "a description set to null",
   "body": "{\"description\": null}"
  },
  {
   "label": "a body that is not JSON",
   "body": "not json at all"
  }
 ],
