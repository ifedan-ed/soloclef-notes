{
 "route": "PUT /api/v1/logs/{log_id}",
 "why": "Every field optional, so the question is which columns a partial body leaves alone — and the row diff is the only place that shows. It also asks the write permission: the route gated on logs:read until 2026-11-08, so a member who could read a workspace's log could rewrite any entry in it.",
 "parameters": {
  "log_id": 1
 },
 "headers": {
  "Content-Type": "application/json"
 },
 "body": "{\"message\": \"changed\"}",
 "tables": [
  "logs"
 ],
 "mint": true,
 "matrices": [
  "credentials",
  "identifiers:log_id",
  "cross_site"
 ],
 "bodies": [
  {
   "label": "one field",
   "body": "{\"message\": \"changed\"}"
  },
  {
   "label": "nothing to change",
   "body": "{}"
  },
  {
   "label": "metadata replaced",
   "body": "{\"log_metadata\": {\"task_name\": \"other\"}}"
  },
  {
   "label": "metadata set to null",
   "body": "{\"log_metadata\": null}"
  },
  {
   "label": "a level no enum member names",
   "body": "{\"level\": \"TRACE\"}"
  },
  {
   "label": "an extra undeclared field",
   "body": "{\"message\": \"changed\", \"nobody_declared_this\": 1}"
  },
  {
   "label": "a body that is not JSON",
   "body": "not json at all"
  }
 ],
 "cases": [
