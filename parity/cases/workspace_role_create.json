{
 "route": "POST /api/v1/workspaces/{workspace_id}/roles",
 "why": "The first write handed over, and the API's first JSON body: a uniqueness read, an UPDATE that can touch several rows and an INSERT, all of which happen or none. The rollback is observable — a default role asked for with a name Postgres cannot store must leave the workspace's existing default alone.",
 "parameters": {
  "workspace_id": 1
 },
 "headers": {
  "Content-Type": "application/json"
 },
 "body": "{\"name\": \"Fresh\"}",
 "tables": [
  "workspace_roles",
  "workspace_memberships"
 ],
 "mint": true,
 "matrices": [
  "credentials",
  "identifiers:workspace_id",
  "cross_site"
 ],
 "bodies": [
  {
   "label": "the smallest valid body",
   "body": "{\"name\": \"Fresh\"}"
  },
  {
   "label": "every field",
   "body": "{\"name\": \"Fresh\", \"description\": \"A new role\", \"permissions\": [\"logs:read\", \"members:view\"], \"is_default\": false}"
  },
  {
   "label": "a missing required field",
   "body": "{}"
  },
  {
   "label": "a name that is empty",
   "body": "{\"name\": \"\"}"
  },
  {
   "label": "a name one character past the column",
   "body": "{\"name\": \"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\"}"
  },
  {
   "label": "a description one character past the column",
   "body": "{\"name\": \"Fresh\", \"description\": \"\"}"
  },
  {
   "label": "a name already used in this workspace",
   "body": "{\"name\": \"Scribe\"}"
  },
  {
   "label": "a name already used in another workspace",
   "body": "{\"name\": \"Reader\"}"
  },
  {
   "label": "an extra undeclared field, which pydantic ignores",
   "body": "{\"name\": \"Fresh\", \"nobody_declared_this\": 1}"
  },
  {
   "label": "permissions that are not a list",
   "body": "{\"name\": \"Fresh\", \"permissions\": \"logs:read\"}"
  },
  {
   "label": "permissions holding something that is not a string",
   "body": "{\"name\": \"Fresh\", \"permissions\": [1, null]}"
  },
  {
   "label": "permissions that are empty",
   "body": "{\"name\": \"Fresh\", \"permissions\": []}"
  },
  {
   "label": "a permission no catalogue entry names",
   "body": "{\"name\": \"Fresh\", \"permissions\": [\"nothing:atall\"]}"
  },
  {
   "label": "is_default as the string true, which pydantic coerces",
   "body": "{\"name\": \"Fresh\", \"is_default\": \"true\"}"
  },
  {
   "label": "is_default as the number one",
   "body": "{\"name\": \"Fresh\", \"is_default\": 1}"
  },
  {
   "label": "is_default as null",
   "body": "{\"name\": \"Fresh\", \"is_default\": null}"
  },
  {
   "label": "a new default role, which unsets the old one",
   "body": "{\"name\": \"Fresh\", \"is_default\": true}"
  },
  {
   "label": "a rollback: a new default whose name the column cannot hold",
   "body": "{\"name\": \"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\", \"is_default\": true}"
  },
  {
   "label": "a name that is a number",
   "body": "{\"name\": 42}"
  },
  {
   "label": "a name that is null",
   "body": "{\"name\": null}"
  },
  {
   "label": "a name carrying markup, an em dash and U+2028",
   "body": "{\"name\": \"a < b & c \\u2014 d\\u2028e\"}"
  },
  {
   "label": "a body that is not JSON",
   "body": "not json at all"
  },
  {
   "label": "a body that is empty",
   "body": ""
  },
  {
   "label": "a body that is an array",
   "body": "[]"
  },
  {
   "label": "a body that is a bare string",
   "body": "\"text\""
  },
  {
   "label": "a body with the same key twice",
   "body": "{\"name\":\"First\",\"name\":\"Second\"}"
  },
  {
   "label": "a body sent as form data",
   "body": "name=Fresh",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded"
   }
  },
  {
   "label": "a body sent with no content type",
   "body": "{\"name\": \"Fresh\"}",
   "headers": {
    "Content-Type": ""
   }
