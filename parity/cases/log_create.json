{
 "route": "POST /api/v1/logs",
 "why": "A write with an enum, a json column and a workspace id in the body rather than the path. The metadata column is written by SQLAlchemy's own JSON form, which only a row diff can see. It also asks the write permission: the route gated on logs:read until 2026-11-08, so anyone who could read a workspace's log could append to it.",
 "headers": {
  "Content-Type": "application/json"
 },
 "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"a parity log\", \"workspace_id\": 1}",
 "tables": [
  "logs"
 ],
 "mint": true,
 "matrices": [
  "credentials",
  "cross_site"
 ],
 "bodies": [
  {
   "label": "the smallest valid body",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 1}"
  },
  {
   "label": "a missing message",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"workspace_id\": 1}"
  },
  {
   "label": "a missing workspace",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\"}"
  },
  {
   "label": "a level no enum member names",
   "body": "{\"level\": \"TRACE\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 1}"
  },
  {
   "label": "a level in the wrong case",
   "body": "{\"level\": \"info\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 1}"
  },
  {
   "label": "a status no enum member names",
   "body": "{\"level\": \"INFO\", \"status\": \"DONE\", \"message\": \"m\", \"workspace_id\": 1}"
  },
  {
   "label": "metadata that is null",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 1, \"log_metadata\": null}"
  },
  {
   "label": "metadata that is a list",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 1, \"log_metadata\": [1, 2]}"
  },
  {
   "label": "metadata nested three deep",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 1, \"log_metadata\": {\"a\": {\"b\": {\"c\": [1, 2.5, null]}}}}"
  },
  {
   "label": "an extra undeclared field",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 1, \"nobody_declared_this\": 1}"
  },
  {
   "label": "a workspace the caller is not in",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 6}"
  },
  {
   "label": "a workspace that does not exist",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 4242}"
  },
  {
   "label": "a workspace id past int32",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": 2147483648}"
  },
  {
   "label": "a workspace id past int64",
   "body": "{\"level\":\"INFO\",\"status\":\"SUCCESS\",\"message\":\"m\",\"workspace_id\":9223372036854775808}"
  },
  {
   "label": "a workspace id as a string, which pydantic coerces",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"workspace_id\": \"1\"}"
  },
  {
   "label": "a workspace id spelled with an underscore",
   "body": "{\"level\":\"INFO\",\"status\":\"SUCCESS\",\"message\":\"m\",\"workspace_id\":\"1_000\"}"
  },
  {
   "label": "a message carrying markup, curly quotes and U+2028",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"a < b & \\u201cc\\u201d\\u2028d\", \"workspace_id\": 1}"
  },
  {
   "label": "a source that is empty",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"source\": \"\", \"workspace_id\": 1}"
  },
  {
   "label": "a source that is null",
   "body": "{\"level\": \"INFO\", \"status\": \"SUCCESS\", \"message\": \"m\", \"source\": null, \"workspace_id\": 1}"
  },
  {
   "label": "a body that is not JSON",
   "body": "not json at all"
  }
 ],
