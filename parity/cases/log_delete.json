{
 "route": "DELETE /api/v1/logs/{log_id}",
 "why": "The one single-log route that always asked for its own permission (logs:delete, where the create and the update asked for logs:read until 2026-11-08). Like them it loaded the row before authorising, so the rows a caller may not touch are asked for here: one of another workspace, and one that is not there, which now answer the same way.",
 "parameters": {
  "log_id": 1
 },
 "tables": [
  "logs"
 ],
 "matrices": [
  "credentials",
  "identifiers:log_id",
  "cross_site"
 ],
 "cases": [
  {
   "label": "a log of another workspace, which answers as one that is not there",
   "path": "/api/v1/logs/6"
  },
  {
   "label": "the same log twice",
   "path": "/api/v1/logs/1"
  },
  {
   "label": "delete a log",
   "as": "owner",
   "path": "/api/v1/logs/5",
   "tables": [
    "logs"
   ]
  },
  {
   "label": "csrf: delete a log by cookie from a foreign origin",
   "as": "cookie_owner",
   "path": "/api/v1/logs/1",
   "headers": {
    "Origin": "https://attacker.example.invalid"
   },
   "tables": [
    "logs"
   ]
  },
  {
