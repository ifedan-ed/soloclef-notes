  {
   "label": "a document with one heading and one bullet",
   "body": "{\"memory_md\": \"## Team notes\\n- 2026-01-01: a note\"}"
  },
  {
   "label": "a missing required field",
   "body": "{}"
  },
  {
   "label": "a document that is null",
   "body": "{\"memory_md\": null}"
  },
  {
   "label": "a document that is empty",
   "body": "{\"memory_md\": \"\"}"
  },
  {
   "label": "a document with no heading at all",
   "body": "{\"memory_md\": \"just a line\"}"
  },
  {
   "label": "an extra undeclared field",
   "body": "{\"memory_md\": \"## H\\n- 2026-01-01: a note\", \"nobody_declared_this\": 1}"
