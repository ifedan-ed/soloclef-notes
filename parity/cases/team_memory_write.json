{
 "route": "PUT /api/v1/workspaces/{workspace_id}/memory",
 "why": "The team document, gated and written the same way — and the one whose column is on a table the Zero publication replicates, so its rows matter beyond the response.",
 "parameters": {
  "workspace_id": 1
 },
 "headers": {
  "Content-Type": "application/json"
 },
 "body": "{\"memory_md\": \"## Team notes\\n- 2026-01-01: a note\"}",
 "tables": [
  "workspaces"
 ],
 "mint": true,
 "matrices": [
  "credentials",
  "identifiers:workspace_id",
  "cross_site"
 ],
