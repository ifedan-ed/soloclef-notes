{
 "route": "GET /api/v1/workspaces/{workspace_id}/my-access",
 "why": "What every page's first render waits on. Its whole body is the permission gate rendered directly, so a disagreement about what a caller may do shows here first.",
 "parameters": {
  "workspace_id": 1
 },
 "matrices": [
  "credentials",
  "identifiers:workspace_id",
  "origins"
 ],
 "cases": [
  {
   "label": "my-access",
   "as": "owner",
   "path": "/api/v1/workspaces/1/my-access"
  },
  {
   "label": "my-access at workspace 1_000",
   "as": "owner",
   "path": "/api/v1/workspaces/1_000/my-access"
  },
  {
   "label": "a foreign-issuer token on my-access with no origin",
   "as": "agent_foreign_issuer",
   "path": "/api/v1/workspaces/1/my-access"
  },
  {
   "label": "a foreign-issuer token on my-access with an allowed origin",
   "as": "agent_foreign_issuer",
   "path": "/api/v1/workspaces/1/my-access",
   "headers": {
    "Origin": "https://notes.example.invalid"
   }
  },
  {
   "label": "a foreign-issuer token on my-access with a foreign origin",
   "as": "agent_foreign_issuer",
   "path": "/api/v1/workspaces/1/my-access",
   "headers": {
    "Origin": "https://attacker.example.invalid"
   }
  },
  {
   "label": "a foreign-issuer token on my-access with a loopback origin",
   "as": "agent_foreign_issuer",
   "path": "/api/v1/workspaces/1/my-access",
   "headers": {
    "Origin": "http://localhost:3000"
   }
  }
 ]
}
